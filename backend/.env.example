# ============================================================
# Divyam Clinic HMS - Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Database
# ---------
# SQLite (for local development):
# DATABASE_URL="file:./dev.db"
#
# PostgreSQL (for production):
DATABASE_URL="postgresql://user:password@localhost:5432/hms?schema=public"

# JWT Secret — generate your own, never commit the real one.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Server
PORT=4000

# Demo Seed (set "true" to allow demo seed in production)
ALLOW_DEMO_SEED="true"

# Node environment
NODE_ENV="development"

# Timezone (required)
TZ="Asia/Kolkata"
